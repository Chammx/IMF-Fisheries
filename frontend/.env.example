# Optional local backend HTTPS origin; production browser requests use the same-origin /api proxy.
# Set IMF_API_URL in the Pages Function or Vercel API proxy runtime, not as a public build variable.
IMF_API_URL=https://YOUR_RAILWAY_SERVICE.up.railway.app
# Set the canonical production frontend origin; Vercel's production URL is used if omitted.
SITE_URL=https://YOUR_PRODUCTION_DOMAIN
