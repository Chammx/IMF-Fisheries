# Local default; Workers does not use this port for external traffic.
PORT=5001
NODE_ENV=production
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-only secret. Set as a Cloudflare Worker secret, never in frontend variables.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
# Admin username and password verifier (do not put the password itself here).
ADMIN_USERNAME=change-this-admin-username
# Generate interactively with: node scripts/hash-admin-password.js
ADMIN_PASSWORD_HASH=replace-with-scrypt-hash
# Generate with a secure password manager or: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Shared only between the Pages Function and Worker; set as a secret in both.
PROXY_SHARED_SECRET=replace-with-a-long-random-secret
# Exact origins, with no trailing slash.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://imf-fisheries.pages.dev
